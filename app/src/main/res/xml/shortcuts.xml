<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_qs_capture_clip"
        android:shortcutShortLabel="@string/shortcut_capture_short"
        android:shortcutLongLabel="@string/shortcut_capture_long">
        <intent
            android:action="com.example.action.QUICK_CAPTURE_CLIPBOARD"
            android:targetPackage="com.aistudio.smartclipboard.qvmkrt"
            android:targetClass="com.example.core.clipboard.QuickCaptureActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_clip"
        android:enabled="true"
        android:icon="@drawable/ic_qs_capture_clip"
        android:shortcutShortLabel="@string/shortcut_new_clip_short"
        android:shortcutLongLabel="@string/shortcut_new_clip_long">
        <intent
            android:action="com.example.action.SHORTCUT_NEW_CLIP"
            android:targetPackage="com.aistudio.smartclipboard.qvmkrt"
            android:targetClass="com.example.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search_clips"
        android:enabled="true"
        android:icon="@drawable/ic_qs_capture_clip"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.example.action.SHORTCUT_SEARCH"
            android:targetPackage="com.aistudio.smartclipboard.qvmkrt"
            android:targetClass="com.example.MainActivity" />
    </shortcut>
</shortcuts>
